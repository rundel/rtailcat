  Write all of \code{data}. On timeout or error the condition's \code{bytes} field gives the number of bytes already sent.
  \subsection{Usage}{
    \if{html}{\out{<div class="r">}}
    \preformatted{TailcatConnection$write(data, timeout = Inf)}
    \if{html}{\out{</div>}}
  }
  \subsection{Arguments}{
    \if{html}{\out{<div class="arguments">}}
    \describe{
      \item{\code{data}}{A raw vector, or a character vector which is pasted together without separators and sent as UTF-8.}
      \item{\code{timeout}}{Seconds to wait; \code{Inf} waits indefinitely and \code{0} polls (sends what can be sent at once).}
    }
    \if{html}{\out{</div>}}
  }
  \subsection{Returns}{
    The number of bytes written (an integer, or a double beyond the integer range), invisibly.
  }
}

\if{html}{\out{<hr>}}
\if{html}{\out{<a id="method-TailcatConnection-write_async"></a>}}
\if{latex}{\out{\hypertarget{method-TailcatConnection-write_async}{}}}
\subsection{\code{TailcatConnection$write_async()}}{
  Asynchronous version of \verb{$write()}.
  \subsection{Usage}{
    \if{html}{\out{<div class="r">}}
    \preformatted{TailcatConnection$write_async(data, timeout = Inf)}
    \if{html}{\out{</div>}}
  }
  \subsection{Arguments}{
    \if{html}{\out{<div class="arguments">}}
    \describe{
      \item{\code{data}}{A raw or character vector.}
      \item{\code{timeout}}{Seconds to wait; \code{Inf} waits indefinitely and \code{0} polls.}
    }
    \if{html}{\out{</div>}}
  }
  \subsection{Returns}{
    A promise resolving with the number of bytes written.
  }
}

\if{html}{\out{<hr>}}
\if{html}{\out{<a id="method-TailcatConnection-close_write"></a>}}
\if{latex}{\out{\hypertarget{method-TailcatConnection-close_write}{}}}
\subsection{\code{TailcatConnection$close_write()}}{
  Half-close a TCP connection: tell the peer there is nothing more to send, while still being able to read its reply.
  \subsection{Usage}{
    \if{html}{\out{<div class="r">}}
    \preformatted{TailcatConnection$close_write(timeout = 30)}
    \if{html}{\out{</div>}}
  }
  \subsection{Arguments}{
    \if{html}{\out{<div class="arguments">}}
    \describe{
      \item{\code{timeout}}{Seconds to wait for pending writes; \code{Inf} waits indefinitely and \code{0} polls.}
    }
    \if{html}{\out{</div>}}
  }
  \subsection{Returns}{
    The connection, invisibly.
  }
}

\if{html}{\out{<hr>}}
\if{html}{\out{<a id="method-TailcatConnection-close_write_async"></a>}}
\if{latex}{\out{\hypertarget{method-TailcatConnection-close_write_async}{}}}
\subsection{\code{TailcatConnection$close_write_async()}}{
  Asynchronous version of \verb{$close_write()}.
  \subsection{Usage}{
    \if{html}{\out{<div class="r">}}
    \preformatted{TailcatConnection$close_write_async(timeout = 30)}
    \if{html}{\out{</div>}}
  }
  \subsection{Arguments}{
    \if{html}{\out{<div class="arguments">}}
    \describe{
      \item{\code{timeout}}{Seconds to wait; \code{Inf} waits indefinitely and \code{0} polls.}
    }
    \if{html}{\out{</div>}}
  }
  \subsection{Returns}{
    A promise resolving with the connection.
  }
}

\if{html}{\out{<hr>}}
\if{html}{\out{<a id="method-TailcatConnection-readable"></a>}}
\if{latex}{\out{\hypertarget{method-TailcatConnection-readable}{}}}
\subsection{\code{TailcatConnection$readable()}}{
  Check without waiting whether a TCP read would return immediately (buffered data, end of stream, or a pending error). Intended for checking idle connections, not as a readiness loop.
  \subsection{Usage}{
    \if{html}{\out{<div class="r">}}
    \preformatted{TailcatConnection$readable()}
    \if{html}{\out{</div>}}
  }
  \subsection{Returns}{
    \code{TRUE} or \code{FALSE}.
  }
}

\if{html}{\out{<hr>}}
\if{html}{\out{<a id="method-TailcatConnection-info"></a>}}
\if{latex}{\out{\hypertarget{method-TailcatConnection-info}{}}}
\subsection{\code{TailcatConnection$info()}}{
  Information about the connection. Because of an upstream tailcat bug it fails with \code{tailcat_failure} once both directions of a TCP connection have been shut down.
  \subsection{Usage}{
    \if{html}{\out{<div class="r">}}
    \preformatted{TailcatConnection$info(timeout = 30)}
    \if{html}{\out{</div>}}
  }
  \subsection{Arguments}{
    \if{html}{\out{<div class="arguments">}}
    \describe{
      \item{\code{timeout}}{Seconds to wait; \code{Inf} waits indefinitely and \code{0} polls.}
    }
    \if{html}{\out{</div>}}
  }
  \subsection{Returns}{
    A list with \code{local_address}, \code{remote_address}, and \code{network}.
  }
}

