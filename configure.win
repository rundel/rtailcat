#!/bin/sh
# Best-effort Windows check (untested): make sure a usable Go is available.
# src/Makevars.win is static and uses RTAILCAT_GO or go on PATH.

required=`sed -n 's/^go[ 	][ 	]*\([0-9][0-9.]*\).*$/\1/p' src/go/go.mod | head -n 1`
if test -z "$GOTOOLCHAIN"; then
  GOTOOLCHAIN=local
fi
export GOTOOLCHAIN

# The package's own go invocations ignore any go.work and the user's GOFLAGS
# (a non-empty GOFLAGS also overrides one saved with `go env -w`).
if test -d src/go/vendor; then
  GOFLAGS=-mod=vendor
else
  GOFLAGS=-mod=readonly
fi
GOWORK=off
export GOWORK GOFLAGS

# src/Makevars.win runs go from src/go, so a relative path would point
# elsewhere there; it cannot be rewritten because Makevars.win is static.
GO="${RTAILCAT_GO:-go}"
case $GO in
  /* | [A-Za-z]:[/\\]*) ;;
  */* | *\\*)
    echo "ERROR: RTAILCAT_GO must be an absolute path to go.exe or a command name on PATH, not the relative path '$GO'." >&2
    exit 1
    ;;
  *)
    if ! command -v "$GO" >/dev/null 2>&1; then
      echo "ERROR: rtailcat needs the Go toolchain (Go >= $required), but '$GO' was not found on PATH. Install Go from https://go.dev/dl/ and put it on PATH, or set RTAILCAT_GO to the full path of go.exe." >&2
      exit 1
    fi
    ;;
esac

if test -d src/go/vendor || test "$RTAILCAT_HERMETIC" = "1"; then
  build_dir=`pwd -W 2>/dev/null || pwd`/src/go/build
  mkdir -p "$build_dir/home/.config" "$build_dir/home/.cache"
  HOME="$build_dir/home"
  USERPROFILE="$build_dir/home"
  APPDATA="$build_dir/home/.config"
  LOCALAPPDATA="$build_dir/home/.cache"
  GOCACHE="$build_dir/gocache"
  GOPATH="$build_dir/gopath"
  GOMODCACHE="$build_dir/gopath/pkg/mod"
  export HOME USERPROFILE APPDATA LOCALAPPDATA GOCACHE GOPATH GOMODCACHE
fi

# Probing from src/go makes Go apply the module's go line, so with a
# GOTOOLCHAIN that allows switching (for example auto) this reports the
# toolchain the build will really use.
found=`cd src/go && "$GO" env GOVERSION 2>/dev/null | sed -n 's/^go\([0-9][0-9.]*\).*$/\1/p'`
if test -z "$found"; then
  found=`cd / && GOTOOLCHAIN=local "$GO" env GOVERSION 2>/dev/null | sed -n 's/^go\([0-9][0-9.]*\).*$/\1/p'`
fi
if test -z "$found"; then
  echo "ERROR: could not run '$GO' to determine its version. rtailcat needs Go >= $required: install Go from https://go.dev/dl/ and put it on PATH, or set RTAILCAT_GO to the full path of go.exe." >&2
  exit 1
fi
version_ok=`echo "$found $required" | awk '{
  n = split($1, a, "."); m = split($2, b, ".");
  for (i = 1; i <= 3; i++) {
    x = (i <= n) ? a[i] + 0 : 0; y = (i <= m) ? b[i] + 0 : 0;
    if (x > y) { print "yes"; exit } else if (x < y) { print "no"; exit }
  }
  print "yes"
}'`
if test "$version_ok" != "yes"; then
  echo "ERROR: rtailcat needs Go >= $required but found Go $found (GOTOOLCHAIN=$GOTOOLCHAIN). Install a newer Go from https://go.dev/dl/, or set GOTOOLCHAIN=auto to let Go download the required toolchain itself." >&2
  exit 1
fi
echo "rtailcat: using Go $found (GOTOOLCHAIN=$GOTOOLCHAIN)"
exit 0
